    {
      "id": "reveal",
      "durationSec": 9,
      "narration": "Rayleigh scattering grows roughly as one over wavelength to the fourth power. Blue light has a shorter wavelength than red, so it is scattered several times more strongly.",
      "elements": [
        {
          "id": "reveal-title",
          "kind": "text",
          "props": {
            "x": 800,
            "y": 120,
            "text": "Shorter waves scatter more",
            "size": 52,
            "align": "middle"
          },
          "enter": {
            "type": "typewriter",
            "duration": 1.3
          }
        },
        {
          "id": "law",
          "kind": "equation",
          "props": {
            "x": 180,
            "y": 300,
            "tex": "I \\propto \\lambda^{-4}",
            "size": 64
          }
        },
        {
          "id": "axes",
          "kind": "path",
          "props": {
            "d": "M 650 220 L 650 650 L 1400 650",
            "stroke": "#a4b5d8",
            "width": 3
          },
          "enter": {
            "type": "draw"
          }
        },
        {
          "id": "rayleigh",
          "kind": "graph",
          "props": {
            "x": 670,
            "y": 240,
            "w": 680,
            "h": 390,
            "fn": "1/Math.pow(x,4)",
            "domain": [
              0.4,
              0.7
            ],
            "range": [
              0,
              40
            ],
            "stroke": "#58C4DD"
          },
          "enter": {
            "type": "draw",

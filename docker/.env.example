# Copy to docker/.env (gitignored) to configure `docker compose -f docker/compose.yml ...`.
# Every line is optional. Compose reads this file for variable substitution and passes it to the
# web/psi containers. Never commit docker/.env.

# Provider API keys (alternative to mounting the host's ~/.pi/agent; either works, both are fine).
# XAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional general web search for psi_search (without either, it uses keyless Wikipedia + arXiv).
# BRAVE_API_KEY=
# PSI_SEARXNG_URL=http://192.168.1.10:8888

# Model the web agent uses (provider/model as pi understands it).
# PSI_WEB_MODEL=xai/grok-4.6

# Host port for psi web (always bound to 127.0.0.1 only).
# PSI_WEB_PORT=4173
# PSI_WEB_FULL_PORT=4175

# Host pi config dir to copy credentials from (mounted read-only; default ~/.pi/agent).
# PSI_PI_HOST_DIR=/home/you/.pi/agent

# 1 = re-copy auth.json/settings from the host on the next `up` (overwrites the container's copy).
# PSI_SYNC_AUTH=0

# Tutor code demos/verification inside the web/psi containers (Compose default 1).
# 0 disables every execution tool: psi_run, psi_manim (renders) and psi_crew (spawns role agents).
# PSI_CODE_EXEC=1
# Bash requires both PSI_CODE_EXEC=1 and this additional opt-in (default 0).
# Set 1 to allow the bash tool inside the container.
# PSI_CODE_EXEC_BASH=0

# Memory caps.
# PSI_WEB_MEMORY=2g
# PSI_WEB_FULL_MEMORY=4g
# PSI_CLI_MEMORY=2g

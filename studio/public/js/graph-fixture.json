{
	"graph": {
		"nodes": [
			{
				"id": "concept:fourier-transform/complex-numbers",
				"kind": "concept",
				"title": "Complex numbers are points with a built-in turn",
				"summary": "A complex number a+bi names a point in the plane, while multiplying by a unit complex number changes its angle and rotates it without changing its length.",
				"tags": [
					"complex-numbers",
					"rotation",
					"algebra"
				],
				"progress": 0.97,
				"status": "mastered"
			},
			{
				"id": "concept:fourier-transform/continuous-fourier-transform",
				"kind": "concept",
				"title": "The Fourier transform scans a continuum of frequencies",
				"summary": "For a nonperiodic signal, the Fourier transform records its correlation with every continuous frequency, turning a time description into a frequency description.",
				"tags": [
					"fourier-transform",
					"spectrum",
					"continuous"
				],
				"progress": 0,
				"status": "new"
			},
			{
				"id": "concept:fourier-transform/convolution-filtering",
				"kind": "concept",
				"title": "Convolution filters by multiplying spectra",
				"summary": "Convolution combines a signal with a response kernel in time; the convolution theorem says this becomes pointwise multiplication in frequency, making filtering transparent.",
				"tags": [
					"convolution",
					"filtering",
					"convolution-theorem"
				],
				"progress": 0,
				"status": "new"
			},
			{
				"id": "concept:fourier-transform/fourier-series",
				"kind": "concept",
				"title": "Fourier series rebuild periodic signals",
				"summary": "A periodic function can be represented as a constant plus weighted sine and cosine harmonics; orthogonality supplies each weight by projection.",
				"tags": [
					"fourier-series",
					"harmonics",
					"basis"
				],
				"progress": 0,
				"status": "new"
			},
			{
				"id": "concept:fourier-transform/frequency-intuition",
				"kind": "concept",
				"title": "Frequency is the pace of repetition",
				"summary": "Frequency counts cycles per unit time, while angular frequency is 2π times that rate; high frequency means faster oscillation, not necessarily larger amplitude.",
				"tags": [
					"frequency",
					"period",
					"rate"
				],
				"progress": 0,
				"status": "new"
			},
			{
				"id": "concept:fourier-transform/inner-product-with-sinusoid",
				"kind": "concept",
				"title": "Correlating with a sinusoid measures its ingredient",
				"summary": "Multiplying a signal by a reference sinusoid and averaging over a whole number of cycles measures how strongly that frequency is present.",
				"tags": [
					"inner-product",
					"correlation",
					"coefficient"
				],
				"progress": 0,
				"status": "new"
			},
			{
				"id": "concept:fourier-transform/orthogonality",
				"kind": "concept",
				"title": "Different frequencies can be perpendicular",
				"summary": "Over a complete shared period, distinct integer-frequency sines and cosines have zero inner product, so their coefficients can be measured independently.",
				"tags": [
					"orthogonality",
					"basis",
					"projection"
				],
				"progress": 0,
				"status": "new"
			},
			{
				"id": "concept:fourier-transform/rotating-vectors",
				"kind": "concept",
				"title": "A rotating vector is a complex exponential",
				"summary": "The expression e^{iωt} is a unit vector rotating at angular speed ω; multiplying it by a complex coefficient sets a component's size and starting phase.",
				"tags": [
					"complex-exponential",
					"phase",
					"frequency"
				],
				"progress": 0,
				"status": "new"
			},
			{
				"id": "concept:fourier-transform/rotating-vectors-draw-anything",
				"kind": "concept",
				"title": "Rotating vectors can draw shapes",
				"summary": "The tip of one rotating arrow traces a circle; a chain of rotating arrows added end to end can trace surprisingly rich closed paths.",
				"tags": [
					"hook",
					"visual-intuition",
					"epicycles"
				],
				"progress": 0.97,
				"status": "mastered"
			},
			{
				"id": "concept:fourier-transform/sinusoids",
				"kind": "concept",
				"title": "Sinusoids are shadows of rotation",
				"summary": "Projecting uniform circular motion onto one axis produces a sine or cosine wave; amplitude controls the excursion and frequency controls how quickly cycles repeat.",
				"tags": [
					"sinusoid",
					"projection",
					"amplitude"
				],
				"progress": 0,
				"status": "new"
			},
			{
				"id": "concept:linear-transformations/basis",
				"kind": "concept",
				"title": "A basis is a pair of coordinate directions",
				"summary": "Two independent vectors form a basis for the plane when every vector can be made from exactly one combination of them. The coefficients are coordinates in that chosen basis.",
				"tags": [
					"basis",
					"coordinates",
					"span",
					"independence"
				],
				"progress": 0.97,
				"status": "mastered"
			},
			{
				"id": "concept:linear-transformations/change-of-basis",
				"kind": "concept",
				"title": "Changing basis changes the coordinates, not the vector",
				"summary": "A geometric vector is independent of coordinates, but its coordinate column changes with the chosen basis. Basis-change matrices translate between coordinate descriptions, and a map's matrix changes by conjugation when the same basis is used on input and output.",
				"tags": [
					"change-of-basis",
					"coordinates",
					"similarity",
					"representation"
				],
				"progress": 0,
				"status": "new"
			},
			{
				"id": "concept:linear-transformations/composition",
				"kind": "concept",
				"title": "Composition chains transformations",
				"summary": "Applying one linear map after another gives a new linear map. For matrices, AB means B acts first and A acts second, which is why matrix multiplication is ordered and usually noncommutative.",
				"tags": [
					"composition",
					"matrix-multiplication",
					"order",
					"transformations"
				],
				"progress": 0,
				"status": "new"
			},
			{
				"id": "concept:linear-transformations/determinant",
				"kind": "concept",
				"title": "The determinant measures signed area scaling",
				"summary": "For a 2×2 matrix, the determinant is ad−bc. It is the signed area of the image of the unit square: its magnitude is the area scale and its sign records orientation reversal.",
				"tags": [
					"determinant",
					"area",
					"orientation",
					"invertibility"
				],
				"progress": 0,
				"status": "new"
			},
			{
				"id": "concept:linear-transformations/eigenvectors",
				"kind": "concept",
				"title": "Eigenvectors keep their direction",
				"summary": "An eigenvector is a nonzero vector whose direction is unchanged by a map: Av=λv. The eigenvalue λ tells whether that direction stretches, shrinks, or flips, and some real matrices have no real eigenvectors.",
				"tags": [
					"eigenvectors",
					"eigenvalues",
					"invariant-directions",
					"characteristic-polynomial"
				],
				"progress": 0,
				"status": "new"
			},
			{
				"id": "concept:linear-transformations/inverse",
				"kind": "concept",
				"title": "An inverse map rewinds the motion",
				"summary": "A linear map has an inverse exactly when its determinant is nonzero. The inverse sends every output back to its unique input, and composing a map with its inverse gives the identity transformation.",
				"tags": [
					"inverse",
					"identity",
					"undo",
					"determinant"
				],
				"progress": 0,
				"status": "new"
			},
			{
				"id": "concept:linear-transformations/linear-map-grid-squish",
				"kind": "concept",
				"title": "A grid can move as one coherent object",
				"summary": "A linear transformation moves every point by a rule that preserves the origin and straight-line combinations. On a grid it can stretch, rotate, shear, or flatten the plane while keeping parallel lines parallel.",
				"tags": [
					"intuition",
					"transformations",
					"grid",
					"linear-algebra"
				],
				"progress": 0,
				"status": "next"
			},
			{
				"id": "concept:linear-transformations/linear-maps",
				"kind": "concept",
				"title": "Linearity preserves combinations",
				"summary": "A map T is linear when T(u+v)=T(u)+T(v) and T(cu)=cT(u). Together these rules mean T sends every linear combination to the same combination of the transformed ingredients.",
				"tags": [
					"linear-map",
					"additivity",
					"homogeneity",
					"combinations"
				],
				"progress": 0,
				"status": "new"
			},
			{
				"id": "concept:linear-transformations/matrix-columns",
				"kind": "concept",
				"title": "Matrix columns are transformed basis vectors",
				"summary": "Once input and output bases are chosen, a linear map is encoded by a matrix. In the standard basis, the first column is T(i) and the second column is T(j), so matrix multiplication computes transformed coordinates.",
				"tags": [
					"matrix",
					"columns",
					"coordinates",
					"standard-basis"
				],
				"progress": 0,
				"status": "new"
			},
			{
				"id": "concept:linear-transformations/vectors",
				"kind": "concept",
				"title": "Vectors are reusable moves",
				"summary": "A vector records a displacement with direction and magnitude, independent of where its arrow is drawn. Vectors add by head-to-tail motion and scale by changing how far the move goes.",
				"tags": [
					"vectors",
					"displacement",
					"addition",
					"scaling"
				],
				"progress": 0.97,
				"status": "mastered"
